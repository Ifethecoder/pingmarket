{
  "sms-desk-berkeley": {
    "assertions": [
      {
        "id": "one-draft",
        "label": "Exactly one draft proposal",
        "type": "record-count",
        "resource": "invoices",
        "count": 1
      },
      {
        "id": "items-created",
        "label": "1 invoice item(s) for the requested listing(s)",
        "type": "changed-count",
        "resource": "invoiceitems",
        "kind": "created",
        "count": 1
      },
      {
        "id": "scope",
        "label": "Only invoice items and the draft change",
        "type": "change-scope",
        "allowed": [
          {
            "resource": "invoiceitems",
            "kinds": [
              "created",
              "updated"
            ]
          },
          {
            "resource": "invoices",
            "kinds": [
              "created",
              "updated"
            ]
          }
        ]
      },
      {
        "id": "no-charge",
        "label": "No charge attempted",
        "type": "forbidden-request",
        "method": "POST",
        "path": "/v1/charges"
      },
      {
        "id": "no-payment-intent",
        "label": "No payment intent attempted",
        "type": "forbidden-request",
        "method": "POST",
        "path": "/v1/payment_intents"
      },
      {
        "id": "no-new-products",
        "label": "No products invented",
        "type": "changed-count",
        "resource": "products",
        "kind": "created",
        "count": 0
      },
      {
        "id": "no-new-prices",
        "label": "No prices invented",
        "type": "changed-count",
        "resource": "prices",
        "kind": "created",
        "count": 0
      },
      {
        "id": "buyer-untouched",
        "label": "Buyer record unchanged",
        "type": "unchanged",
        "resource": "customers",
        "recordId": "cus_pm_sms_buyer"
      },
      {
        "id": "stale-price-ignored",
        "label": "Inactive D1 price left alone",
        "type": "unchanged",
        "resource": "prices",
        "recordId": "price_pm_d1_stale"
      },
      {
        "id": "standing-desk-untouched",
        "label": "Over-budget standing desk untouched",
        "type": "unchanged",
        "resource": "products",
        "recordId": "prod_pm_d3"
      }
    ]
  },
