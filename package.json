{
  "name": "pingmarket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:messaging": "tsc -p tsconfig.messaging.json",
    "test": "vitest run",
    "test:messaging": "node --import tsx --test tests/messaging/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "darwin:probe": "tsx scripts/darwin-probe.ts",
    "darwin:acceptance": "tsx scripts/darwin-acceptance.ts",
    "dial:doctor": "node --env-file=.env.local --import tsx scripts/dial/doctor.ts",
    "dial:numbers": "node --env-file=.env.local --import tsx scripts/dial/doctor.ts --numbers",
    "dial:serve": "node --env-file=.env.local --import tsx scripts/dial/server.ts",
    "dial:send-test": "node --env-file=.env.local --import tsx scripts/dial/send-test.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "stripe:sellers": "node --env-file=.env.local --import tsx scripts/stripe-sellers.ts",
    "stripe:samples": "node --env-file=.env.local --import tsx scripts/stripe-samples.ts",
    "keewano:check": "node --env-file=.env.local --import tsx scripts/keewano-check.ts",
    "keewano:backfill": "node --env-file=.env.local --import tsx scripts/keewano-backfill.ts",
    "sparta:open": "worlds starters open --project ./sparta",
    "sparta:run": "worlds starters run --project ./sparta --all",
    "sparta:evidence": "worlds starters run --project ./sparta --all --runs 3 --scenario interruption --evidence ./sparta/evidence/submission.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@getdial/sdk": "^0.41.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "sparta_worlds": "0.9.0-beta.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
