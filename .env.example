# Copy to .env.local; never commit populated keys.

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use an embedded PGlite Postgres stored in ./.pglite
# (auto-migrated + auto-seeded on first request). Set it to a Supabase/Postgres
# connection string for a shared database, then run `npm run db:migrate && npm run db:seed`.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pingmarket

# --- Darwin Search (Developer B) ------------------------------------------------
# Public Search works without a key at the anonymous rate limit.
# "Ask this agent" (Darwin Act, /api/darwin/act) needs an account key with Search + Act scopes,
# created at https://app.darwin.so/me?section=developer. Server-side only.
# DARWIN_API_KEY=
DARWIN_SEARCH_MAX_RESULTS=5
DARWIN_SEARCH_TIMEOUT_MS=20000

# --- Dial (Developer A) ----------------------------------------------------------
# See docs/DIAL_SETUP.md. Validate with `npm run dial:doctor`.
DIAL_API_KEY=
# Number A: PingMarket service number, in E.164 format (for example +14155550100).
DIAL_SERVICE_NUMBER=
DIAL_SERVICE_NUMBER_ID=
# Number B: the real BUYER's phone (seeded as `u_sms_buyer`). It texts DIAL_SERVICE_NUMBER
# (SEARCH / DETAILS / OFFER / ACCEPT / DECLINE / AGENT / HELP / STOP) and is the only number we ever text.
# Use a consenting test handset. Changing it is reconciled into the DB on the next restart.
DIAL_PARTICIPANT_NUMBER=
DIAL_PARTICIPANT_NUMBER_ID=
# Optional if Number B belongs to another Dial account; otherwise leave blank.
DIAL_PARTICIPANT_API_KEY=
# Obtain from the Dial webhook subscription after registering the HTTPS endpoint
# (Next app: https://<tunnel>/api/dial/webhook; standalone test server: npm run dial:serve).
DIAL_WEBHOOK_SECRET=
# Sending is opt-in, including replies from the local connectivity test and the Next app.
# When false, replies are still stored in `messages` (dashboard trace) but not sent.
DIAL_SEND_ENABLED=false
DIAL_TEST_PORT=8787

# --- Stripe test mode (PM-11) ------------------------------------------------------
# See docs/STRIPE_SETUP.md. The secret key is the ONLY Stripe setting the payment flow needs.
# Test mode only: keys must start with sk_test_ (or rk_test_).
# Stripe Dashboard -> your Sandbox (or "Test mode") -> Developers -> API keys -> Secret key.
STRIPE_SECRET_KEY=
# OPTIONAL webhook backstop (catches tabs closed before the redirect, delayed payment methods).
# Signing secret printed by `npm run stripe:listen` locally, or shown on the webhook endpoint in the
# Stripe Dashboard for a deployed URL. Leave blank to confirm payments without a webhook.
STRIPE_WEBHOOK_SECRET=
# Public origin for Checkout success/cancel URLs (server-only, read at runtime).
# Optional in development (defaults to the request origin); REQUIRED in production,
# where checkout returns 503 APP_URL_REQUIRED without it.
# Also used for the Stripe link texted to the SMS buyer after ACCEPT (NEXT_PUBLIC_APP_URL is a fallback).
# APP_URL=http://localhost:3000
# Platform fee kept from each seller payout (Stripe Connect test transfer), in whole basis points of the
# settled NET amount (after Stripe's fee): 0 = seller gets the full net (default), 250 = 2.5%. Max 10000.
PLATFORM_FEE_BPS=0
# The operator test routes POST /api/orders/{id}/payout and POST /api/stripe/sellers answer 403 in
# production unless this is "true".
# ALLOW_TEST_PAYOUT_ROUTES=false

# --- Keewano analytics (demand-aware negotiation) -----------------------------------
# See docs/KEEWANO_SETUP.md. Validate with `npm run keewano:check`; seed history with `npm run keewano:backfill`.
# Event ingestion (offers, counters, accepts, views, searches): an SDK key from Settings -> Project -> API Keys.
# KEEWANO_API_KEY=
# Live SQL for the negotiation insight (pgsql.keewano.com): personal access token (kwpat-...) from
# Settings -> Personal -> Security, the email you signed up with, and Settings -> Details -> Project ID.
# KEEWANO_PAT=
# KEEWANO_USER_EMAIL=
# KEEWANO_PROJECT_ID=
# Per-query timeout on the request path (ms).
KEEWANO_QUERY_TIMEOUT_MS=4000

# --- Sparta Worlds (npm run sparta:*) ---------------------------------------------
# No credentials needed. Runs locally against Sparta's Stripe twin. The `worlds` runner injects
# WORLDS_BASE_URL / WORLDS_API_KEY / WORLDS_TASK_JSON into sparta/agent.mts, so don't set them here.
