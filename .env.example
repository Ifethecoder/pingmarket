# Copy to .env.local; never commit populated keys.

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use an embedded PGlite Postgres stored in ./.pglite
# (auto-migrated + auto-seeded on first request). Set it to a Supabase/Postgres
# connection string for a shared database, then run `npm run db:migrate && npm run db:seed`.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pingmarket

# --- Darwin Search (Developer B) ------------------------------------------------
# Public Search works without a key at the anonymous rate limit.
# DARWIN_API_KEY=
DARWIN_SEARCH_MAX_RESULTS=5
DARWIN_SEARCH_TIMEOUT_MS=20000

# --- Dial (Developer A) ----------------------------------------------------------
# See docs/DIAL_SETUP.md. Validate with `npm run dial:doctor`.
DIAL_API_KEY=
# Number A: PingMarket service number, in E.164 format (for example +14155550100).
DIAL_SERVICE_NUMBER=
DIAL_SERVICE_NUMBER_ID=
# Number B: consenting participant used for this test, not a personal mobile.
DIAL_PARTICIPANT_NUMBER=
DIAL_PARTICIPANT_NUMBER_ID=
# Optional if Number B belongs to another Dial account; otherwise leave blank.
DIAL_PARTICIPANT_API_KEY=
# Obtain from the Dial webhook subscription after registering the HTTPS endpoint.
DIAL_WEBHOOK_SECRET=
# Sending is opt-in, including replies from the local connectivity test.
DIAL_SEND_ENABLED=false
DIAL_TEST_PORT=8787

# --- Stripe test mode (PM-11) ------------------------------------------------------
# See docs/STRIPE_SETUP.md. Test mode only: keys must start with sk_test_ (or rk_test_).
# Dashboard -> Developers -> API keys (with "Test mode" on) -> Secret key.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook: printed by `npm run stripe:listen` locally,
# or shown on the webhook endpoint in the Stripe Dashboard for a deployed URL.
STRIPE_WEBHOOK_SECRET=
# Public origin for Checkout success/cancel URLs (server-only, read at runtime).
# Optional in development (defaults to the request origin); REQUIRED in production,
# where checkout returns 503 APP_URL_REQUIRED without it.
# APP_URL=http://localhost:3000
